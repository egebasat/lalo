# Copy to .env (git-ignored) and fill in what you need:  cp .env.example .env
#
# docker compose loads this file into the container (env_file), so anything set
# here applies INSIDE the container. Values under "Host only" use host paths:
# keep them commented out here and export them in your shell instead.
# Nothing in this file is required for the default setup.

# --- Model download (scripts/download_model.py, host) ------------------------
# Hugging Face token, only needed for gated models (e.g. Llama, Gemma).
# HF_TOKEN=hf_xxx

# --- MCP server secrets ------------------------------------------------------
# Referenced from config.yaml as ${VAR}. An MCP server whose ${VAR} is unset
# fails to start (shown as "failed" in /tools); the rest of the app still runs.
# Example: used by the disabled `some_remote` entry.
# SOME_API_KEY=

# --- Notes tools ---------------------------------------------------------------
# Where add_note / list_notes / search_notes keep their notes (default: data/notes.json).
# docker-compose.yml sets it to /data/notes.json inside the container.
# NOTES_FILE=./data/notes.json

# --- Config overrides (optional) ---------------------------------------------
# Path to the config file (default: config.yaml).
# AGENT_CONFIG=config.yaml
# Any config.yaml key: AGENT__<SECTION>__<KEY>. Container-safe examples:
# AGENT__GENERATION__ENABLE_THINKING=false
# AGENT__AGENT__MAX_ITERATIONS=6
# AGENT__MODEL__PATH=/models/Qwen3-4B

# --- Host only (export in your shell, don't set here) ------------------------
# AGENT__MODEL__PATH=./models/Qwen3-1.7B     # run the server/CLI outside Docker
# AGENT__MODEL__PATH=./models/Qwen3-4B       # the larger model (python -m scripts.download_model Qwen/Qwen3-4B)
# AGENT__MODEL__PATH=./models/Qwen3-4B-8bit  # default; from the above via: python -m mlx_lm convert --hf-path models/Qwen3-4B --mlx-path models/Qwen3-4B-8bit -q --q-bits 8
# AGENT__LOGGING__TRACE_DIR=./data/traces
# AGENT_URL=http://127.0.0.1:8000            # where the tkinter GUI connects
